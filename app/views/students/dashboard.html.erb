<% content_for :head do %>
  <title>Dashboard · Practice-BR</title>
  <style>
    .level-card-link { text-decoration:none; display:block; }
    .level-card-link:hover .level-card-inner { border-color:var(--brand-bright); transform:translateY(-2px); transition:all .15s ease; }
    .level-card-inner { transition:all .15s ease; }
  </style>
<% end %>

<%
  # A conta toda vive no presenter — aqui em cima eram ~100 linhas de Ruby
  # misturadas com o HTML. Cada bloco visual virou um partial em
  # `students/dashboard/`, para que a versão mobile possa mexer numa seção sem
  # abrir um arquivo de mil linhas.
  dash = StudentDashboardPresenter.new(
    user:                current_user,
    activities_by_level: @activities_by_level,
    completed_ids:       session[:completed_quizzes] || [],
    level_filter:        params[:level]
  )

  current_streak = current_user.current_streak
  last_score     = session[:last_quiz_score]
%>

<div class="dash-outer" style="max-width:1000px; margin:0 auto;" data-user-id="<%= current_user.id %>" id="student-dashboard-root">

  <%= render 'students/dashboard/level_pending_notice' unless current_user.level_assigned? %>

  <% if params[:level].present? %>

    <%= render 'students/dashboard/level_view' %>

  <% else %>

    <%= render 'students/dashboard/greeting' %>
    <%= render 'students/dashboard/start_here' %>

    <%= render 'students/dashboard/metrics',
          current_streak:  current_streak,
          last_score:      last_score,
          total_completed: dash.total_completed,
          overall_pct:     dash.overall_pct %>

    <div class="dash-mid-grid" style="margin-bottom:1.5rem;">
      <%= render 'students/dashboard/continue_studying',
            continue_activity:       dash.continue_activity,
            last_completed_activity: dash.last_completed_activity %>

      <%= render 'students/dashboard/progress',
            levels_data:       dash.levels_data,
            cefr_levels:       dash.cefr_levels,
            completed_ids:     dash.completed_ids,
            accessible_levels: dash.accessible_levels %>
    </div>

    <%= render 'students/dashboard/levels',
          levels_data:       dash.levels_data,
          accessible_levels: dash.accessible_levels %>

    <%= render 'students/dashboard/achievements', current_streak: current_streak %>
    <%= render 'students/dashboard/written_expressions' %>

  <% end %>

  <%= render 'students/dashboard/weekly_reminder' %>
  <%= render 'students/dashboard/email_language' %>
  <%= render 'students/dashboard/past_due_notice' %>
  <%= render 'students/dashboard/cancel_subscription' %>
  <%= render 'students/dashboard/account_actions' %>

</div>

<%= render 'students/dashboard/daily_limit_modal' %>
<%= render 'students/pwa_banner' %>
