<% unless current_user.level_assigned? %>
  <div style="background:var(--error-tint); border:1px solid var(--error-border); border-radius:14px; padding:24px 28px; margin-bottom:1.5rem; text-align:center;">
    <div style="font-size:2rem; margin-bottom:10px;">🔒</div>
    <div style="font-family:'Raleway',sans-serif; font-size:1.05rem; font-weight:700; color:var(--error); margin-bottom:6px;">
      Aguardando seu nível de acesso
    </div>
    <div style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.88rem; color:var(--error-deep); line-height:1.6;">
      Seu professor ainda não definiu seu nível. Assim que ele fizer isso, as atividades disponíveis para você aparecerão aqui.
    </div>
  </div>
<% end %>
