<table width="100%" cellpadding="0" cellspacing="0" style="background:#F7F5F0; padding:40px 16px; font-family:'Helvetica Neue',Arial,sans-serif;">
  <tr>
    <td align="center">
      <table width="520" cellpadding="0" cellspacing="0" style="background:#fff; border-radius:16px; border:1px solid #DDD9D2; overflow:hidden; max-width:520px;">
        <tr>
          <td style="background:#0F3826; padding:24px 32px;">
            <div style="font-size:1.1rem; font-weight:800; color:#fff;">Practice-BR</div>
          </td>
        </tr>
        <tr>
          <td style="padding:28px 32px;">
            <div style="font-size:1.8rem; margin-bottom:12px;">🎓</div>
            <div style="font-size:1.15rem; font-weight:700; color:#1C1917; margin-bottom:10px;">
              Nova pessoa na sua turma<%= ", #{@teacher.greeting_name}" if @teacher.greeting_name.present? %>
            </div>
            <p style="font-size:0.92rem; line-height:1.6; color:#5C5853; margin:0 0 16px;">
              <strong><%= @student.display_name %></strong> (nível <%= @student.level %>) agora faz parte da sua turma na
              Practice-BR. Você vê as atividades feitas, as notas e as expressões escritas para comentar.
            </p>
            <p style="font-size:0.85rem; line-height:1.6; color:#5C5853; margin:0 0 20px;">
              Email: <%= @student.email %>
            </p>
            <a href="<%= @url %>"
               style="display:inline-block; background:#1A6B4A; color:#fff; text-decoration:none; font-size:0.92rem; font-weight:700; padding:12px 26px; border-radius:10px;">
              Ver o perfil →
            </a>
            <p style="font-size:0.8rem; line-height:1.55; color:#9C9892; margin:18px 0 0;">
              A pessoa também recebeu um email avisando que você acompanha o progresso dela.
            </p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
