<% content_for :head do %>
  <title>Organismo de formação · Practice-BR</title>
<% end %>

<div style="max-width:720px; margin:0 auto;">

  <%# ── Breadcrumb ── %>
  <div style="display:flex; align-items:center; gap:8px; margin-bottom:1.5rem;
              font-family:'Plus Jakarta Sans',sans-serif; font-size:0.82rem; color:var(--ink-faint);">
    <%= link_to "Dashboard", teacher_dashboard_path, style: "color:var(--ink-faint); text-decoration:none;" %>
    <span>›</span>
    <span style="color:var(--ink); font-weight:600;">Organismo de formação</span>
  </div>

  <%# ── Header ── %>
  <h1 style="font-family:'Raleway',sans-serif; font-size:1.75rem; font-weight:800; color:var(--ink); margin:0 0 10px 0;">
    Organismo de formação
  </h1>

  <p style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.92rem; color:var(--ink-soft); line-height:1.65; margin:0 0 8px;">
    Estes dados vão impressos na atestação que você emite para suas alunas. Quem
    assina o documento é <strong>você</strong>, como organismo de formação — o
    Practice-BR é a ferramenta que gera o PDF, não quem emite.
  </p>

  <p style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.85rem; color:var(--ink-faint); line-height:1.6; margin:0 0 24px;">
    Preencher é opcional. Só faz falta na hora de emitir uma atestação de verdade —
    se você não usa isso, pode ignorar esta tela para sempre. 🌱
  </p>

  <%# ── Estado ── %>
  <% if @teacher.organisme_complete? %>
    <div style="background:var(--brand-mist); border:1.5px solid var(--success-border); border-radius:12px;
                padding:14px 18px; margin-bottom:24px;">
      <div style="font-family:'Raleway',sans-serif; font-weight:800; color:var(--brand-deep); font-size:0.95rem; margin-bottom:3px;">
        Tudo preenchido ✓
      </div>
      <div style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.84rem; color:var(--ink-soft);">
        Suas atestações saem como documento completo, com sua identidade legal.
      </div>
    </div>
  <% elsif @teacher.organisme_started? %>
    <div style="background:var(--warning-tint); border:1.5px solid var(--warning-border); border-radius:12px;
                padding:14px 18px; margin-bottom:24px;">
      <div style="font-family:'Raleway',sans-serif; font-weight:800; color:var(--warning-ink); font-size:0.95rem; margin-bottom:3px;">
        Falta preencher
      </div>
      <div style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.84rem; color:var(--ink-soft);">
        <%= @teacher.missing_organisme_fields.to_sentence.capitalize %>. Enquanto faltar,
        a atestação sai marcada como incompleta.
      </div>
    </div>
  <% end %>

  <%# ── Formulário ── %>
  <div style="background:var(--surface); border:1.5px solid var(--line); border-radius:16px; padding:28px;">
    <%= form_with model: @teacher, url: teacher_organisation_path, method: :patch do |form| %>

      <h2 style="font-family:'Raleway',sans-serif; font-size:1.05rem; font-weight:800; color:var(--ink); margin:0 0 4px;">
        Quem emite
      </h2>
      <div style="height:2px; background:var(--brand-tint); border-radius:2px; margin-bottom:18px;"></div>

      <%= render "teachers/org_field", form: form, field: :org_name,
            label: "Raison sociale",
            hint: "O nome legal do seu organismo, como está registrado.",
            placeholder: "Ex.: Mon Organisme de Formation SASU" %>

      <%= render "teachers/org_field", form: form, field: :org_siret,
            label: "SIRET",
            hint: "14 dígitos. Pode digitar com espaços — a gente limpa. O número tem um dígito verificador, então um dígito trocado é recusado aqui em vez de aparecer no PDF.",
            placeholder: "851 947 937 00013" %>

      <%= render "teachers/org_field", form: form, field: :org_nda,
            label: "Numéro de déclaration d'activité (NDA)",
            hint: "O registro que autoriza você a emitir formação, junto à DREETS da sua região.",
            placeholder: "11 75 12345 75" %>

      <%= render "teachers/org_field", form: form, field: :org_address,
            label: "Endereço",
            hint: "O endereço do organismo, como deve aparecer no documento.",
            placeholder: "12 rue de la Formation, 75011 Paris", area: true %>

      <%= render "teachers/org_field", form: form, field: :org_signatory,
            label: "Quem assina",
            hint: "Nome e função de quem assina a atestação. Costuma ser você mesma.",
            placeholder: "Marie Dupont, gérante" %>

      <h2 style="font-family:'Raleway',sans-serif; font-size:1.05rem; font-weight:800; color:var(--ink); margin:28px 0 4px;">
        Qual é a formação
      </h2>
      <div style="height:2px; background:var(--brand-tint); border-radius:2px; margin-bottom:18px;"></div>

      <%= render "teachers/org_field", form: form, field: :training_title,
            label: "Intitulé da ação de formação",
            hint: "O nome da formação no documento. A atestação lista as atividades, mas precisa dizer de que formação elas fazem parte.",
            placeholder: "Portugais brésilien — formation à distance" %>

      <%# Submit de formulário = --action, pelo design system. %>
      <div style="margin-top:26px; display:flex; justify-content:flex-end;">
        <%= form.submit "Salvar",
              style: "font-family:'Raleway',sans-serif; font-size:0.92rem; font-weight:800; color:var(--surface);
                      background:var(--action); border:none; border-radius:10px; padding:12px 28px; cursor:pointer;" %>
      </div>
    <% end %>
  </div>

  <p style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.8rem; color:var(--ink-faint);
            line-height:1.6; margin:20px 0 0; text-align:center;">
    Os rótulos ficam em francês de propósito: são os termos que o financiador procura no documento.
  </p>

</div>
