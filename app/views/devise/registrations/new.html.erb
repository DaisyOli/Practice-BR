<div class="container mx-auto flex justify-center items-center min-h-screen">
  <div class="card bg-white shadow-lg p-4" style="width: 100%; max-width: 400px;">
    <div class="card-body">
      <h2 class="card-title text-center mb-4">Sign Up</h2>

      <!-- Formulário de Sign Up -->
      <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: 'needs-validation' }) do |f| %>
        <!-- Campo de Email -->
        <div class="mb-3">
          <%= f.input :email, required: true, autofocus: true, autocomplete: "email", 
                      label: "Email", input_html: { class: "form-input", placeholder: "Enter your email" } %>
        </div>

        <!-- Campo de Senha -->
        <div class="mb-3">
          <%= f.input :password, required: true, autocomplete: "new-password", 
                      label: "Password", hint: (@minimum_password_length ? "#{@minimum_password_length} characters minimum" : nil), 
                      input_html: { class: "form-input", placeholder: "Enter your password" } %>
        </div>

        <!-- Campo de Confirmação de Senha -->
        <div class="mb-3">
          <%= f.input :password_confirmation, required: true, autocomplete: "new-password", 
                      label: "Password Confirmation", input_html: { class: "form-input", placeholder: "Confirm your password" } %>
        </div>

        <!-- Botão de Sign Up -->
        <div class="d-grid">
          <%= f.button :submit, "Sign up", class: "btn btn-primary btn-block" %>
        </div>

        <%# Aviso de privacidade no momento do cadastro, como o RGPD exige. %>
        <p class="mt-3 text-center" style="font-size:0.72rem; line-height:1.5; color:var(--ink-faint);">
          En créant votre compte, vous acceptez notre
          <%= link_to "politique de confidentialité", privacy_path,
                target: "_blank", rel: "noopener",
                style: "color:var(--brand); text-decoration:underline;" %>.
        </p>
      <% end %>

      <!-- Links adicionais -->
      <div class="mt-3 text-center">
        <%= link_to "Log in", new_session_path(resource_name), class: "text-decoration-none" %> |
        <%= link_to "Forgot your password?", new_password_path(resource_name), class: "text-decoration-none" %>
      </div>
    </div>
  </div>
</div>
