<%
  type_styles = {
    'multiple_choice' => { bg:'var(--info-tint)', text:'var(--info-deep)', border:'var(--info-border)' },
    'fill_in_blank'   => { bg:'var(--violet-tint)', text:'var(--violet-deep)', border:'var(--violet-border)' },
  }
  ts = type_styles[question.question_type] || { bg:'var(--neutral-tint)', text:'var(--ink)', border:'var(--line)' }
%>

<div id="question-<%= question.id %>" style="border:1px solid var(--brand-tint-2); border-radius:10px; overflow:hidden; background:var(--surface);">

  <%# Question header %>
  <div style="display:flex; align-items:center; justify-content:space-between; padding:9px 14px; background:var(--brand-tint); border-bottom:1px solid var(--brand-tint-2);">
    <div style="display:flex; align-items:center; gap:8px;">
      <span style="font-family:'DM Mono',monospace; font-size:0.7rem; font-weight:700; color:var(--brand);">
        <%= "%02d" % (index + 1) %>
      </span>
      <span style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.7rem; font-weight:700; padding:3px 9px; border:1px solid <%= ts[:border] %>; border-radius:6px; background:<%= ts[:bg] %>; color:<%= ts[:text] %>;">
        <%= t("questions.types.#{question.question_type}") %>
      </span>
    </div>
    <% if activity.teacher == current_user %>
      <div style="display:flex; gap:6px;">
        <button type="button"
                data-controller="collapse" data-collapse-target-value="#edit-question-form-<%= question.id %>" data-action="collapse#toggle"
                style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.72rem; font-weight:600; color:var(--ink-soft); padding:4px 9px; border:1.5px solid var(--line); border-radius:6px; background:var(--surface); cursor:pointer;">
          Editar
        </button>
        <%= button_to activity_question_path(activity, question),
            method: :delete,
            data: { confirm: t('questions.confirm_delete') },
            style: "font-family:'Plus Jakarta Sans',sans-serif; font-size:0.72rem; font-weight:600; color:var(--error); padding:4px 9px; border:1.5px solid var(--error-border); border-radius:6px; background:var(--error-tint); cursor:pointer;" do %>
          Remover
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Question content %>
  <div style="padding:14px;">
    <p style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.92rem; color:var(--ink); margin:0 0 12px 0; line-height:1.55;">
      <% if question.fill_in_blank? %>
        <% safe_c = sanitize(question.content.to_s, tags: %w[p br strong em u], attributes: []) %>
        <%= safe_c.gsub('_____', '<span style="display:inline-block; width:140px; border-bottom:2px solid var(--violet-deep);">&nbsp;</span>').html_safe %>
      <% else %>
        <%= sanitize(question.content.to_s, tags: %w[p br strong em u], attributes: []) %>
      <% end %>
    </p>

    <% if question.multiple_choice? && question.options.any? %>
      <ul style="list-style:none; margin:0 0 10px 0; padding:0; display:flex; flex-direction:column; gap:5px;">
        <% question.options.each do |option| %>
          <% is_correct = question.correct_answer == option %>
          <li style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.85rem; padding:7px 12px; border-radius:8px; border:1px solid <%= is_correct ? 'var(--brand-bright)' : 'var(--line)' %>; background:<%= is_correct ? 'var(--brand-tint)' : 'var(--surface)' %>; color:<%= is_correct ? 'var(--brand-deep)' : 'var(--ink)' %>; font-weight:<%= is_correct ? '600' : '400' %>;">
            <%= option %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <div style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.78rem; font-weight:600; color:var(--brand);">
      <% all_answers = question.fill_in_blank? ? question.all_correct_answers.reject(&:blank?) : [] %>
      <% if all_answers.length > 1 %>
        <% all_answers.each_with_index do |ans, i| %>
          ✓ Lacuna <%= i + 1 %>: <%= ans %><% unless i == all_answers.length - 1 %> &nbsp;·&nbsp;<% end %>
        <% end %>
      <% else %>
        ✓ <%= t('questions.correct_answer') %>: <%= question.correct_answer %>
      <% end %>
    </div>
  </div>

</div>

<% if activity.teacher == current_user %>
  <div class="hidden" id="edit-question-form-<%= question.id %>">
    <div style="padding:20px; border:1px solid var(--brand-tint-2); border-top:none; border-radius:0 0 10px 10px; background:var(--surface-2); margin-top:-1px;">
      <div data-controller="question-selector">
        <%= form_with model: [question.activity, question], html: { id: "edit-form-#{question.id}" } do |form| %>
          <div class="mb-4">
            <div>
              <%= form.label :question_type, t('questions.form.question_type') %>
              <%= form.select :question_type,
                  Question::QUESTION_TYPES.map { |type| [t("questions.types.#{type}"), type] },
                  { selected: question.question_type || 'multiple_choice' },
                  { class: "form-select",
                    data: { question_selector_target: "selector",
                            action: "change->question-selector#change" } } %>
            </div>
          </div>

          <div class="mb-4">
            <div>
              <%= form.label :content, t('questions.form.question_content') %>
              <div id="quill-editor-edit-<%= question.id %>"></div>
              <%= form.hidden_field :content, id: "quill-content-edit-#{question.id}", value: question.content %>
            </div>
          </div>

          <div class="mb-4 fill-in-blank-help" data-question-selector-target="fillInBlank"
               style="display: <%= question.fill_in_blank? ? 'block' : 'none' %>;">
            <div>
              <div class="alert alert-info">
                <%= t('questions.form.fill_in_blank_help_html') %>
              </div>
            </div>
          </div>

          <div class="mb-4 multiple-choice-fields" data-question-selector-target="multipleChoice"
               style="display: <%= question.multiple_choice? ? 'block' : 'none' %>;">
            <div>
              <%= form.label :options, t('questions.form.options') %>
              <%= form.text_area :options_text, value: question.options&.join(','), class: "form-textarea", rows: 3 %>
              <small class="form-hint"><%= t('questions.form.options_help') %></small>
            </div>
          </div>

          <%# Questão com IA — open_ended %>
          <div class="mb-4 open-ended-fields" data-question-selector-target="openEnded"
               style="display:<%= question.open_ended? ? 'block' : 'none' %>;">
            <div>
              <div style="background:var(--warning-tint); border:1px solid var(--warning-border); border-radius:8px; padding:12px 14px; font-size:0.85rem; color:var(--warning-ink); font-family:'Plus Jakarta Sans',sans-serif; margin-bottom:12px;">
                <strong>✨ <%= t('questions.form.open_ended_info_title') %></strong><br>
                <%= t('questions.form.open_ended_info') %>
              </div>
              <%= form.label :evaluation_prompt, t('questions.form.evaluation_prompt_label'), class: "form-label" %>
              <%= form.text_area :evaluation_prompt, class: "form-textarea", rows: 3,
                  placeholder: t('questions.form.evaluation_prompt_placeholder') %>
              <small class="form-hint"><%= t('questions.form.evaluation_prompt_hint') %></small>
              <div style="margin-top:12px;">
                <label class="form-label"><%= t('questions.form.weight_label') %></label>
                <div style="display:flex; gap:8px; margin-top:4px; flex-wrap:wrap;">
                  <% [1, 2, 3].each do |w| %>
                    <label style="display:flex; align-items:center; gap:6px; padding:7px 14px; border:1.5px solid <%= (question.weight || 1) == w ? 'var(--action)' : 'var(--line)' %>; border-radius:8px; background:<%= (question.weight || 1) == w ? 'var(--warning-tint)' : 'var(--surface)' %>; cursor:pointer; font-family:'Plus Jakarta Sans',sans-serif; font-size:0.82rem; font-weight:600; color:<%= (question.weight || 1) == w ? 'var(--warning-ink)' : 'var(--ink-soft)' %>;">
                      <%= form.radio_button :weight, w, style: "accent-color:var(--action);" %>
                      ×<%= w %><%= w == 1 ? " (#{t('questions.form.weight_normal')})" : "" %>
                    </label>
                  <% end %>
                </div>
                <small class="form-hint"><%= t('questions.form.weight_hint') %></small>
              </div>
            </div>
          </div>

          <%# Resposta única — multiple_choice %>
          <div class="mb-4" data-question-selector-target="correctAnswer"
               style="display:<%= (question.fill_in_blank? || question.open_ended?) ? 'none' : 'block' %>;">
            <div>
              <%= form.label :correct_answer, t('questions.form.correct_answer') %>
              <%= form.text_field :correct_answer, class: "form-input" %>
            </div>
          </div>

          <%# Respostas múltiplas — fill_in_blank %>
          <% fib_answers = question.fill_in_blank? ? question.all_correct_answers.reject(&:blank?) : [] %>
          <% fib_count   = [fib_answers.length, 1].max %>
          <div class="mb-4 fill-in-blank-answers" data-question-selector-target="fillInBlankAnswers"
               style="display:<%= question.fill_in_blank? ? 'block' : 'none' %>;">
            <div>
              <label class="form-label">Respostas</label>
              <% 4.times do |i| %>
                <div class="fib-answer-field" data-blank-index="<%= i %>"
                     style="margin-bottom:8px; display:<%= i < fib_count ? 'flex' : 'none' %>; align-items:center; gap:10px;">
                  <span style="font-family:'DM Mono',monospace; font-size:0.72rem; font-weight:700; color:var(--brand); background:var(--brand-tint); border:1px solid var(--brand-bright); border-radius:6px; padding:3px 8px; flex-shrink:0; min-width:62px; text-align:center;">
                    Lacuna <%= i + 1 %>
                  </span>
                  <input type="text"
                         name="question[correct_answers][]"
                         value="<%= fib_answers[i] %>"
                         class="form-input"
                         style="margin-bottom:0; flex:1;"
                         placeholder="Resposta correta <%= i + 1 %>">
                </div>
              <% end %>
              <button type="button" id="fib-add-btn-<%= question.id %>"
                      style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.8rem; font-weight:600;
                             color:var(--brand-deep); padding:6px 12px; border:1.5px solid var(--success-border); border-radius:20px;
                             background:var(--brand-tint); cursor:pointer; margin-top:6px;
                             display:<%= fib_count >= 4 ? 'none' : 'inline-flex' %>; align-items:center; gap:5px;">
                + Adicionar lacuna
              </button>
            </div>
          </div>

          <div>
            <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
              <%= form.submit t('common.save'),
                    style: "background:var(--info-deep); color:var(--surface); font-family:'Plus Jakarta Sans',sans-serif; font-size:0.88rem; font-weight:700; border:none; border-radius:12px; padding:9px 24px; cursor:pointer;" %>
              <% if question.persisted? %>
                <%= link_to t('common.delete'),
                    activity_question_path(activity, question),
                    data: { turbo_method: :delete, turbo_confirm: t('common.confirm_delete') },
                    style: "font-family:'Plus Jakarta Sans',sans-serif; font-size:0.82rem; font-weight:600; color:var(--error); padding:8px 14px; border:1.5px solid var(--error-border); border-radius:10px; background:var(--error-tint); cursor:pointer; text-decoration:none;" %>
              <% end %>
            </div>
          </div>

          <script>
            (function() {
              var qid = '<%= question.id %>';

              function initQuillEdit() {
                var editorEl = document.getElementById('quill-editor-edit-' + qid);
                if (!editorEl || editorEl.dataset.quillInit) return;
                editorEl.dataset.quillInit = '1';

                var quill = new Quill(editorEl, {
                  theme: 'snow',
                  modules: { toolbar: [['bold', 'italic', 'underline']] }
                });

                var existing = <%= raw json_escape((question.content || '').to_json) %>;
                if (existing && existing.trim()) {
                  quill.clipboard.dangerouslyPasteHTML(
                    existing.charAt(0) === '<' ? existing : existing.replace(/\n/g, '<br>')
                  );
                }

                var hiddenInput = document.getElementById('quill-content-edit-' + qid);
                quill.on('text-change', function() {
                  hiddenInput.value = quill.root.innerHTML;
                });

                var formEl = document.getElementById('edit-form-' + qid);
                if (formEl) {
                  formEl.addEventListener('submit', function() {
                    hiddenInput.value = quill.root.innerHTML;
                  });
                }
              }

              function updateEditFields() {
                const form = document.getElementById('edit-form-' + qid);
                if (!form) return;
                const select = form.querySelector('select[name="question[question_type]"]');
                if (!select) return;
                const type = select.value;
                const multipleChoiceFields = form.querySelector('.multiple-choice-fields');
                const fillInBlankHelp      = form.querySelector('.fill-in-blank-help');
                const fillInBlankAnswers   = form.querySelector('.fill-in-blank-answers');
                const openEndedFields      = form.querySelector('.open-ended-fields');
                const correctAnswerField   = form.querySelector('[data-question-selector-target="correctAnswer"]');
                if (multipleChoiceFields)  multipleChoiceFields.style.display  = 'none';
                if (fillInBlankHelp)       fillInBlankHelp.style.display       = 'none';
                if (fillInBlankAnswers)    fillInBlankAnswers.style.display    = 'none';
                if (openEndedFields)       openEndedFields.style.display       = 'none';
                if (correctAnswerField)    correctAnswerField.style.display    = 'none';
                switch (type) {
                  case 'multiple_choice':
                    if (multipleChoiceFields) multipleChoiceFields.style.display = 'block';
                    if (correctAnswerField)   correctAnswerField.style.display   = 'block';
                    break;
                  case 'fill_in_blank':
                    if (fillInBlankHelp)    fillInBlankHelp.style.display    = 'block';
                    if (fillInBlankAnswers) fillInBlankAnswers.style.display = 'block';
                    break;
                  case 'open_ended':
                    if (openEndedFields) openEndedFields.style.display = 'block';
                    break;
                }
              }

              function initFibAddBtn() {
                var addBtn = document.getElementById('fib-add-btn-' + qid);
                if (!addBtn) return;
                addBtn.addEventListener('click', function() {
                  var form = document.getElementById('edit-form-' + qid);
                  if (!form) return;
                  var fields = Array.from(form.querySelectorAll('.fib-answer-field'));
                  var nextHidden = fields.find(function(f) { return f.style.display === 'none'; });
                  if (nextHidden) {
                    nextHidden.style.display = 'flex';
                    nextHidden.querySelector('input').focus();
                  }
                  var stillHidden = fields.some(function(f) { return f.style.display === 'none'; });
                  if (!stillHidden) addBtn.style.display = 'none';
                });
              }

              function init() {
                const form = document.getElementById('edit-form-' + qid);
                if (!form) return;
                const select = form.querySelector('select[name="question[question_type]"]');
                if (select) select.addEventListener('change', updateEditFields);
                const collapse = document.getElementById('edit-question-form-' + qid);
                if (collapse) {
                  collapse.addEventListener('collapse:shown', function() {
                    updateEditFields();
                    initQuillEdit();
                  });
                }
                updateEditFields();
                initFibAddBtn();
              }

              if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
              } else {
                init();
              }
            })();
          </script>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
