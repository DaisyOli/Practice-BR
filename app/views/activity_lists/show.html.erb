<% content_for :head do %>
  <title>Atividades <%= @level %> · Practice-BR</title>
  <%# Na impressão (= "Baixar PDF") fica só a lista: sem menu, sem botões,
      sem rodapé, e nenhuma atividade partida entre duas páginas. %>
  <style>
    @media print {
      #main-navbar, .no-print, footer { display: none !important; }
      body { background: #fff !important; }
      .list-outer { max-width: none !important; padding: 0 !important; }
      .list-item { break-inside: avoid; }
      .list-link { color: #1A6B4A !important; }
    }
  </style>
<% end %>

<%
  link_for = ->(a) { solve_activity_url(a) }
  copy_lines = ["📚 Practice-BR · Atividades #{@level}", ""]
  if @path.any?
    copy_lines << "Comece por estas, nesta ordem:"
    @path.each_with_index { |a, i| copy_lines << "#{i + 1}. #{a.title}#{" (#{a.theme})" if a.theme.present?} — #{link_for.(a)}" }
    copy_lines << ""
  end
  if @by_theme.any?
    copy_lines << (@path.any? ? "Mais atividades:" : "Atividades:")
    @by_theme.each do |theme, acts|
      copy_lines << "▸ #{theme}"
      acts.each { |a| copy_lines << "• #{a.title} — #{link_for.(a)}" }
    end
  end
%>

<div class="dash-outer list-outer" style="max-width:820px; margin:0 auto;">

  <div class="no-print" style="margin-bottom:1.25rem;">
    <%= link_to "← Voltar ao painel", teacher_dashboard_path,
          style: "font-family:'Plus Jakarta Sans',sans-serif; font-size:0.82rem; font-weight:600; color:var(--ink-soft); text-decoration:none;" %>
  </div>

  <%# Cabeçalho que também sai no PDF. %>
  <div style="margin-bottom:1.25rem;">
    <div style="font-family:'DM Mono',monospace; font-size:0.7rem; color:var(--brand); letter-spacing:0.08em; text-transform:uppercase; margin-bottom:6px;">
      Practice-BR · Português do Brasil
    </div>
    <h1 style="font-family:'Raleway',sans-serif; font-size:1.7rem; font-weight:800; color:var(--ink); margin:0 0 6px;">
      📚 Atividades do nível <%= @level %>
    </h1>
    <p style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.9rem; color:var(--ink-soft); margin:0;">
      Exercícios curtos com o resultado na hora. Clique no nome da atividade para fazer.
    </p>
  </div>

  <%# ── Só na tela: escolher o nível, copiar, baixar ── %>
  <div class="no-print" style="background:var(--surface); border:1px solid var(--line); border-radius:14px; padding:16px 18px; margin-bottom:1.5rem;">
    <div style="display:flex; flex-wrap:wrap; gap:8px; margin-bottom:14px;">
      <% User::CEFR_LEVELS.each do |lvl| %>
        <%= link_to activity_list_path(level: lvl),
              style: "font-family:'DM Mono',monospace; font-size:0.78rem; font-weight:700; padding:6px 14px; border-radius:20px; text-decoration:none; " \
                     "#{lvl == @level ? 'background:var(--brand); color:var(--surface);' : 'background:var(--brand-tint); color:var(--brand-deep);'}" do %>
          <%= lvl %> <span style="opacity:0.7; font-weight:400;">(<%= @counts[lvl].to_i %>)</span>
        <% end %>
      <% end %>
    </div>
    <div style="display:flex; flex-wrap:wrap; gap:10px;">
      <button type="button" id="copy-list"
              style="background:var(--brand); color:var(--surface); border:none; border-radius:10px; padding:10px 18px;
                     font-family:'Plus Jakarta Sans',sans-serif; font-size:0.88rem; font-weight:700; cursor:pointer;">
        📋 Copiar para WhatsApp ou email
      </button>
      <button type="button" onclick="window.print()"
              style="background:var(--surface); color:var(--brand-deep); border:1.5px solid var(--brand-soft); border-radius:10px; padding:10px 18px;
                     font-family:'Plus Jakarta Sans',sans-serif; font-size:0.88rem; font-weight:700; cursor:pointer;">
        📄 Baixar PDF
      </button>
    </div>
    <p style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.76rem; color:var(--ink-faint); margin:10px 0 0; line-height:1.5;">
      Em "Baixar PDF", escolha <strong>Salvar como PDF</strong> como destino. Os links abrem para alunos com acesso à Practice-BR;
      quem não tem conta cai na tela de entrar.
    </p>
    <textarea id="copy-text" readonly style="position:absolute; left:-9999px;"><%= copy_lines.join("\n") %></textarea>
  </div>

  <%# ── O percurso: na ordem ── %>
  <% if @path.any? %>
    <h2 style="font-family:'Raleway',sans-serif; font-size:1.1rem; font-weight:800; color:var(--brand-deep); margin:0 0 10px;">
      🧭 Comece por estas, nesta ordem
    </h2>
    <div style="display:flex; flex-direction:column; gap:8px; margin-bottom:1.75rem;">
      <% @path.each_with_index do |a, i| %>
        <div class="list-item" style="display:flex; gap:12px; background:var(--surface); border:1px solid var(--line); border-radius:12px; padding:12px 14px;">
          <span style="flex-shrink:0; width:26px; height:26px; border-radius:50%; background:var(--brand-tint); color:var(--brand-deep);
                       display:flex; align-items:center; justify-content:center; font-family:'DM Mono',monospace; font-size:0.78rem; font-weight:700;">
            <%= i + 1 %>
          </span>
          <div style="min-width:0;">
            <a href="<%= link_for.(a) %>" class="list-link"
               style="font-family:'Raleway',sans-serif; font-size:0.98rem; font-weight:800; color:var(--ink); text-decoration:none;">
              <%= a.title %>
            </a>
            <% if a.theme.present? %>
              <span style="font-family:'DM Mono',monospace; font-size:0.68rem; color:var(--brand); margin-left:6px;"><%= a.theme %></span>
            <% end %>
            <div style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.82rem; color:var(--ink-soft); line-height:1.45; margin-top:2px;">
              <%= truncate(a.description.to_s.squish, length: 140) %>
            </div>
            <div style="font-family:'DM Mono',monospace; font-size:0.66rem; color:var(--ink-faint); margin-top:3px; word-break:break-all;">
              <%= link_for.(a) %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# ── O resto: por tema ── %>
  <% if @by_theme.any? %>
    <h2 style="font-family:'Raleway',sans-serif; font-size:1.1rem; font-weight:800; color:var(--ink); margin:0 0 10px;">
      <%= @path.any? ? "🏷️ Mais atividades, por tema" : "🏷️ Atividades por tema" %>
    </h2>
    <% @by_theme.each do |theme, acts| %>
      <div style="margin-bottom:1.1rem;">
        <div style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.86rem; font-weight:700; color:var(--brand-deep); margin-bottom:6px;">
          <%= theme %> <span style="color:var(--ink-faint); font-weight:400;">(<%= acts.size %>)</span>
        </div>
        <% acts.each do |a| %>
          <div class="list-item" style="padding:6px 0 6px 12px; border-left:2px solid var(--brand-soft); margin-bottom:4px;">
            <a href="<%= link_for.(a) %>" class="list-link"
               style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.9rem; font-weight:700; color:var(--ink); text-decoration:none;">
              <%= a.title %>
            </a>
            <div style="font-family:'DM Mono',monospace; font-size:0.64rem; color:var(--ink-faint); word-break:break-all;"><%= link_for.(a) %></div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <% if @path.empty? && @by_theme.empty? %>
    <p style="font-family:'Plus Jakarta Sans',sans-serif; color:var(--ink-faint); text-align:center; padding:2rem 0;">
      Ainda não há atividades publicadas no <%= @level %> 🌱
    </p>
  <% end %>
</div>

<script>
  (function () {
    var btn = document.getElementById("copy-list");
    if (!btn) return;
    btn.addEventListener("click", function () {
      var text = document.getElementById("copy-text").value;
      var done = function () { btn.textContent = "✅ Copiado! É só colar"; setTimeout(function () { btn.textContent = "📋 Copiar para WhatsApp ou email"; }, 2500); };
      if (navigator.clipboard) {
        navigator.clipboard.writeText(text).then(done, function () { fallback(); });
      } else { fallback(); }
      function fallback() {
        var ta = document.getElementById("copy-text");
        ta.select();
        try { document.execCommand("copy"); done(); } catch (e) { alert("Não consegui copiar — selecione o texto manualmente."); }
      }
    });
  })();
</script>
