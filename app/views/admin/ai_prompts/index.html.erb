<% content_for :head do %>
  <title>A voz das IAs · Admin</title>
<% end %>

<div class="dash-outer" style="max-width:900px; margin:0 auto;">

  <%= link_to admin_root_path,
        style: "display:inline-flex; align-items:center; gap:6px; font-family:'Plus Jakarta Sans',sans-serif;
                font-size:0.82rem; font-weight:600; color:var(--ink-soft); text-decoration:none; margin-bottom:1.25rem;" do %>
    ← Painel Admin
  <% end %>

  <%# ── Cabeçalho ── %>
  <div style="margin-bottom:2rem;">
    <div style="display:flex; align-items:center; gap:10px; margin-bottom:4px;">
      <h1 style="font-family:'Raleway',sans-serif; font-size:1.75rem; font-weight:700; color:var(--ink); margin:0;">
        A voz das IAs
      </h1>
      <span style="font-family:'DM Mono',monospace; font-size:0.65rem; font-weight:700; letter-spacing:0.1em;
                   background:var(--action); color:var(--surface); padding:3px 10px; border-radius:20px; text-transform:uppercase;">
        ✨ IA
      </span>
    </div>
    <p style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.9rem; color:var(--ink-soft); margin:0;">
      O texto que diz a cada IA como se comportar. Editar aqui vale na próxima chamada — sem deploy.
    </p>
  </div>

  <%# ── Aviso: isto fala com os alunos ── %>
  <div style="background:var(--warning-tint); border:1px solid var(--warning-border); border-radius:14px;
              padding:16px 20px; margin-bottom:2rem; display:flex; gap:12px; align-items:flex-start;">
    <span style="font-size:1.1rem; line-height:1.3;">☕</span>
    <p style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.85rem; color:var(--ink-soft); margin:0; line-height:1.6;">
      O que você escrever aqui chega aos alunos na hora seguinte. Não tem revisão de ninguém no meio do caminho —
      então vale ler duas vezes antes de salvar. Se der errado, o botão
      <strong style="color:var(--ink);">voltar ao original</strong> desfaz tudo.
    </p>
  </div>

  <% @groups.each do |group, items| %>
    <h2 style="font-family:'Raleway',sans-serif; font-size:1rem; font-weight:700; color:var(--ink);
               margin:0 0 12px; padding-bottom:8px; border-bottom:1.5px solid var(--line);">
      <%= group %>
    </h2>

    <div style="display:flex; flex-direction:column; gap:10px; margin-bottom:2.25rem;">
      <% items.each do |key, entry| %>
        <% record     = @saved[key] %>
        <% customized = record.present? && record.customized? %>

        <%= link_to edit_admin_ai_prompt_path(key),
              style: "display:block; background:var(--surface); border:1px solid var(--line); border-radius:14px;
                      padding:18px 20px; text-decoration:none; transition:border-color 0.15s;" do %>
          <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:6px;">
            <span style="font-family:'Raleway',sans-serif; font-size:0.98rem; font-weight:700; color:var(--ink);">
              <%= entry[:label] %>
            </span>

            <% if customized %>
              <span style="font-family:'DM Mono',monospace; font-size:0.62rem; font-weight:700; letter-spacing:0.08em;
                           background:var(--brand-tint); color:var(--brand-deep); border:1px solid var(--brand-border);
                           padding:3px 9px; border-radius:20px; text-transform:uppercase; flex-shrink:0;">
                reescrito
              </span>
            <% else %>
              <span style="font-family:'DM Mono',monospace; font-size:0.62rem; color:var(--ink-faint);
                           flex-shrink:0;">
                original
              </span>
            <% end %>
          </div>

          <p style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.82rem; color:var(--ink-soft);
                    margin:0; line-height:1.55;">
            <%= entry[:hint] %>
          </p>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%# ── A IA que não tem prompt ── %>
  <h2 style="font-family:'Raleway',sans-serif; font-size:1rem; font-weight:700; color:var(--ink);
             margin:0 0 12px; padding-bottom:8px; border-bottom:1.5px solid var(--line);">
    Transcrição de áudio
  </h2>
  <div style="background:var(--paper); border:1px dashed var(--line); border-radius:14px; padding:18px 20px;">
    <span style="font-family:'Raleway',sans-serif; font-size:0.98rem; font-weight:700; color:var(--ink-soft);">
      Whisper
    </span>
    <p style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.82rem; color:var(--ink-faint);
              margin:6px 0 0; line-height:1.55;">
      Esta é a única IA do app sem prompt nenhum: ela transcreve o que ouve e devolve texto, sem instrução de
      comportamento. Está listada aqui para você não procurar depois.
    </p>
  </div>

</div>
