<% content_for :head do %>
  <title><%= entry[:label] %> · A voz das IAs</title>
<% end %>

<div class="dash-outer" style="max-width:900px; margin:0 auto;"
     data-controller="prompt-editor"
     data-prompt-editor-default-value="<%= @default %>">

  <%= link_to admin_ai_prompts_path,
        style: "display:inline-flex; align-items:center; gap:6px; font-family:'Plus Jakarta Sans',sans-serif;
                font-size:0.82rem; font-weight:600; color:var(--ink-soft); text-decoration:none; margin-bottom:1.25rem;" do %>
    ← A voz das IAs
  <% end %>

  <div style="margin-bottom:1.5rem;">
    <p style="font-family:'DM Mono',monospace; font-size:0.68rem; color:var(--ink-faint);
              letter-spacing:0.06em; margin:0 0 4px; text-transform:uppercase;">
      <%= entry[:group] %>
    </p>
    <h1 style="font-family:'Raleway',sans-serif; font-size:1.6rem; font-weight:700; color:var(--ink); margin:0 0 8px;">
      <%= entry[:label] %>
    </h1>
    <p style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.88rem; color:var(--ink-soft);
              margin:0; line-height:1.6;">
      <%= entry[:hint] %>
    </p>
  </div>

  <%# ── O que não pode sumir do texto ── %>
  <% obrigatorios = Array(entry[:placeholders]).map { |p| "{{#{p}}}" } + Array(entry[:markers]) %>
  <% if obrigatorios.any? %>
    <div style="background:var(--info-tint); border:1px solid var(--info-border); border-radius:14px;
                padding:14px 18px; margin-bottom:1.25rem;">
      <p style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.8rem; color:var(--ink-soft);
                margin:0 0 8px; line-height:1.55;">
        Estas palavras são o acordo com o código. Reescreva tudo à volta delas, mas não as apague —
        o app não deixa salvar sem elas:
      </p>
      <div style="display:flex; flex-wrap:wrap; gap:6px;">
        <% obrigatorios.each do |token| %>
          <code style="font-family:'DM Mono',monospace; font-size:0.74rem; background:var(--surface);
                       border:1px solid var(--info-border); color:var(--ink); padding:3px 9px; border-radius:6px;">
            <%= token %>
          </code>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= form_with url: admin_ai_prompt_path(@key), method: :patch, local: true, scope: :ai_prompt do |f| %>
    <div style="background:var(--surface); border:1px solid var(--line); border-radius:16px;
                padding:20px; margin-bottom:1rem;">

      <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:10px;">
        <label for="ai_prompt_body"
               style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.82rem; font-weight:700; color:var(--ink);">
          O texto
        </label>
        <span data-prompt-editor-target="counter"
              style="font-family:'DM Mono',monospace; font-size:0.72rem; color:var(--ink-faint);"></span>
      </div>

      <%= f.text_area :body, value: @body, id: "ai_prompt_body",
            rows: 24,
            data: { prompt_editor_target: "body", action: "input->prompt-editor#update" },
            style: "width:100%; font-family:'DM Mono',monospace; font-size:0.8rem; line-height:1.65;
                    color:var(--ink); background:var(--paper); border:1.5px solid var(--line);
                    border-radius:10px; padding:16px; resize:vertical; box-sizing:border-box;" %>
    </div>

    <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:2.5rem;">
      <button type="submit"
              style="background:var(--action); color:var(--surface); font-family:'Plus Jakarta Sans',sans-serif;
                     font-weight:700; font-size:0.88rem; border:none; border-radius:10px; padding:12px 26px;
                     cursor:pointer;">
        Salvar
      </button>

      <span data-prompt-editor-target="dirty"
            style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.78rem; color:var(--warning-ink); display:none;">
        alterações não salvas
      </span>
    </div>
  <% end %>

  <%# ── Voltar ao original ── %>
  <% if @record&.customized? %>
    <div style="background:var(--paper); border:1px solid var(--line); border-radius:14px;
                padding:18px 20px; margin-bottom:1.5rem; display:flex; align-items:center;
                justify-content:space-between; gap:16px; flex-wrap:wrap;">
      <p style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.82rem; color:var(--ink-soft);
                margin:0; line-height:1.55; flex:1; min-width:220px;">
        Este texto está reescrito. Voltar ao original apaga a sua versão e faz o app usar de novo
        o texto que está no código.
      </p>
      <%= button_to "Voltar ao original", admin_ai_prompt_path(@key), method: :delete,
            form: { data: { turbo_confirm: "Isso apaga o seu texto e volta ao original do código. Continuar?" } },
            style: "background:var(--surface); color:var(--ink-soft); font-family:'Plus Jakarta Sans',sans-serif;
                    font-weight:600; font-size:0.82rem; border:1.5px solid var(--line); border-radius:10px;
                    padding:10px 18px; cursor:pointer; white-space:nowrap;" %>
    </div>
  <% end %>

  <%# ── Histórico ── %>
  <% if @versions.any? %>
    <h2 style="font-family:'Raleway',sans-serif; font-size:1rem; font-weight:700; color:var(--ink);
               margin:0 0 12px; padding-bottom:8px; border-bottom:1.5px solid var(--line);">
      Versões anteriores
    </h2>
    <div style="display:flex; flex-direction:column; gap:8px;">
      <% @versions.each do |version| %>
        <div style="background:var(--surface); border:1px solid var(--line); border-radius:12px;
                    padding:14px 18px; display:flex; align-items:center; justify-content:space-between;
                    gap:16px; flex-wrap:wrap;">
          <div style="flex:1; min-width:200px;">
            <p style="font-family:'DM Mono',monospace; font-size:0.76rem; color:var(--ink); margin:0 0 4px;">
              <%= l(version.created_at, format: :short) %>
            </p>
            <p style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.76rem; color:var(--ink-faint); margin:0;">
              <%= version.body.length %> caracteres
            </p>
          </div>
          <%= button_to "Restaurar", restore_admin_ai_prompt_path(@key, version_id: version.id), method: :post,
                form: { data: { turbo_confirm: "Restaurar esta versão? O texto atual vira histórico." } },
                style: "background:var(--surface); color:var(--brand-deep); font-family:'Plus Jakarta Sans',sans-serif;
                        font-weight:600; font-size:0.8rem; border:1.5px solid var(--brand-border); border-radius:10px;
                        padding:8px 16px; cursor:pointer; white-space:nowrap;" %>
        </div>
      <% end %>
    </div>
  <% end %>

</div>
