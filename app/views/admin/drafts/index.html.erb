<% content_for :head do %>
  <title>Agente de Conteúdo · Admin</title>
<% end %>

<div class="dash-outer" style="max-width:1100px; margin:0 auto;">

  <%# ── Voltar ── %>
  <%= link_to admin_root_path,
        style: "display:inline-flex; align-items:center; gap:6px; font-family:'Plus Jakarta Sans',sans-serif;
                font-size:0.82rem; font-weight:600; color:var(--ink-soft); text-decoration:none; margin-bottom:1.25rem;" do %>
    ← Painel Admin
  <% end %>

  <%# ── Cabeçalho ── %>
  <div style="display:flex; align-items:flex-start; justify-content:space-between; flex-wrap:wrap; gap:16px; margin-bottom:2rem;">
    <div>
      <div style="display:flex; align-items:center; gap:10px; margin-bottom:4px;">
        <h1 style="font-family:'Raleway',sans-serif; font-size:1.75rem; font-weight:700; color:var(--ink); margin:0;">
          Agente de Conteúdo
        </h1>
        <span style="font-family:'DM Mono',monospace; font-size:0.65rem; font-weight:700; letter-spacing:0.1em;
                     background:var(--action); color:var(--surface); padding:3px 10px; border-radius:20px; text-transform:uppercase;">
          ✨ IA
        </span>
      </div>
      <p style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.9rem; color:var(--ink-soft); margin:0;">
        Progresso de geração · <%= @drafts.count %> rascunho<%= @drafts.count == 1 ? '' : 's' %> aguardando revisão
      </p>
    </div>

    <%= form_with url: admin_generate_draft_path, method: :post, local: true,
          style: "display:flex; align-items:center; gap:8px; flex-wrap:wrap;" do |f| %>
      <%# Os níveis vêm do enum do Activity, não da tabela de metas: um nível
          sem meta fica fora do automático mas continua escolhível na mão. %>
      <%= f.select :level,
            [["Nível automático", ""]] + Activity.levels.keys.map { |l| [l, l] },
            {},
            style: "font-family:'Plus Jakarta Sans',sans-serif; font-size:0.85rem; font-weight:600;
                    border:1.5px solid var(--line); border-radius:10px; padding:10px 14px; background:var(--surface);
                    color:var(--ink); cursor:pointer;" %>
      <button type="submit"
              style="background:var(--brand); color:var(--surface); font-family:'Plus Jakarta Sans',sans-serif; font-weight:700;
                     font-size:0.88rem; border:none; border-radius:10px; padding:12px 24px; cursor:pointer;
                     display:inline-flex; align-items:center; gap:8px;"
              data-turbo-confirm="Vai chamar a IA agora. Pode levar até 30 segundos. Continuar?">
        ✨ Gerar 1 agora
      </button>
    <% end %>
  </div>

  <%# ── Progresso por nível ── %>
  <div style="background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:28px; margin-bottom:1.5rem;">
    <div style="display:flex; align-items:baseline; justify-content:space-between; gap:12px; margin-bottom:20px;">
      <h2 style="font-family:'Raleway',sans-serif; font-size:1rem; font-weight:700; color:var(--ink); margin:0;">
        Progresso por nível
      </h2>
      <span style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.76rem; color:var(--ink-faint);">
        publicadas + rascunhos · a mesma conta que o agente usa para decidir
      </span>
    </div>

    <%= form_with url: admin_draft_targets_path, method: :patch do %>
      <div style="display:flex; flex-direction:column; gap:14px;">
        <% @goals.each do |level, goal| %>
          <% count = @generated.fetch(level, 0) %>
          <% c = cefr_colors(level) %>
          <div style="display:flex; align-items:center; gap:14px;">
            <span style="font-family:'DM Mono',monospace; font-size:0.72rem; font-weight:700;
                         background:<%= c[:bg] %>; color:<%= c[:text] %>; border:1.5px solid <%= c[:border] %>;
                         padding:3px 10px; border-radius:20px; min-width:38px; text-align:center; flex-shrink:0;">
              <%= level %>
            </span>

            <div style="flex:1; background:var(--paper); border-radius:99px; height:10px; overflow:hidden;">
              <% if goal %>
                <% pct = [(count.to_f / goal * 100).round, 100].min %>
                <div style="width:<%= pct %>%; height:100%; border-radius:99px; background:<%= c[:bar] %>; transition:width 0.4s;"></div>
              <% end %>
            </div>

            <span style="font-family:'DM Mono',monospace; font-size:0.82rem; color:var(--ink);
                         min-width:34px; text-align:right; flex-shrink:0;">
              <%= count %>
            </span>
            <span style="font-family:'DM Mono',monospace; font-size:0.82rem; color:var(--ink-faint); flex-shrink:0;">/</span>
            <%= number_field_tag "goals[#{level}]", goal, min: 1, placeholder: "—",
                  "aria-label": "Meta do nível #{level}",
                  style: "font-family:'DM Mono',monospace; font-size:0.82rem; color:var(--ink); width:62px;
                          border:1.5px solid var(--line); border-radius:8px; padding:5px 8px;
                          background:var(--surface); text-align:center; flex-shrink:0;" %>

            <span style="font-family:'DM Mono',monospace; font-size:0.72rem; flex-shrink:0;
                         min-width:74px; text-align:right;
                         color:<%= goal && count >= goal ? 'var(--brand)' : 'var(--ink-faint)' %>;
                         font-weight:<%= goal && count >= goal ? '700' : '400' %>;">
              <% if goal.nil? %>
                sem meta
              <% elsif count >= goal %>
                ✓ Meta
              <% else %>
                faltam <%= goal - count %>
              <% end %>
            </span>
          </div>
        <% end %>
      </div>

      <div style="margin-top:16px; padding-top:16px; border-top:1px solid var(--line-soft);
                  display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;">
        <%# Só entram no total os níveis que têm meta — somar um nível sem meta
            inventaria um alvo que ninguém definiu. %>
        <% with_goal     = @goals.compact %>
        <% total_goal    = with_goal.values.sum %>
        <% total_count   = with_goal.keys.sum { |lvl| @generated.fetch(lvl, 0) } %>
        <span style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.85rem; color:var(--ink-soft);">
          <% if total_goal.zero? %>
            Nenhum nível tem meta definida.
          <% else %>
            Total nos níveis com meta:
            <strong style="color:var(--ink);"><%= total_count %></strong> de
            <strong style="color:var(--ink);"><%= total_goal %></strong>
            (<%= [(total_count.to_f / total_goal * 100).round, 100].min %>%)
          <% end %>
          <% if @goals.value?(nil) %>
            <span style="color:var(--ink-faint);">
              · nível sem meta fica fora do automático, mas pode ser gerado escolhendo na lista acima
            </span>
          <% end %>
        </span>

        <button type="submit"
                style="background:var(--action); color:var(--surface); font-family:'Plus Jakarta Sans',sans-serif;
                       font-weight:700; font-size:0.82rem; border:none; border-radius:10px; padding:10px 20px;
                       cursor:pointer; flex-shrink:0;">
          Salvar metas
        </button>
      </div>
    <% end %>
  </div>

  <%# ── Rascunhos pendentes ── %>
  <div style="background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:28px;">
    <h2 style="font-family:'Raleway',sans-serif; font-size:1rem; font-weight:700; color:var(--ink); margin:0 0 20px;">
      Rascunhos aguardando revisão
    </h2>

    <% if @drafts.empty? %>
      <div style="text-align:center; padding:40px 20px; color:var(--ink-faint);">
        <div style="font-size:2rem; margin-bottom:8px;">🎉</div>
        <div style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.9rem;">Nenhum rascunho pendente.</div>
      </div>
    <% else %>
      <div style="display:flex; flex-direction:column; gap:10px;">
        <% @drafts.each do |activity| %>
          <% exercise_count = activity.questions.size + activity.sentence_orderings.size +
                              activity.paragraph_orderings.size + activity.column_matchings.size %>
          <% c = cefr_colors(activity.level) %>
          <div style="display:flex; align-items:center; gap:14px; padding:14px 18px;
                      border:1px solid var(--line-soft); border-radius:12px; background:var(--surface-2);">

            <span style="font-family:'DM Mono',monospace; font-size:0.7rem; font-weight:700;
                         background:<%= c[:bg] %>; color:<%= c[:text] %>; border:1.5px solid <%= c[:border] %>;
                         padding:2px 8px; border-radius:20px; flex-shrink:0;">
              <%= activity.level %>
            </span>

            <div style="flex:1; min-width:0;">
              <div style="font-family:'Plus Jakarta Sans',sans-serif; font-size:0.9rem; font-weight:600;
                          color:var(--ink); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                <%= activity.title %>
              </div>
              <div style="font-family:'DM Mono',monospace; font-size:0.72rem; color:var(--ink-faint); margin-top:2px;">
                <%= exercise_count %> exercício<%= exercise_count == 1 ? '' : 's' %> ·
                gerada <%= time_ago_in_words(activity.created_at) %> atrás
              </div>
            </div>

            <div style="display:flex; gap:8px; flex-shrink:0;">
              <%= link_to review_draft_activity_path(activity),
                    style: "font-family:'Plus Jakarta Sans',sans-serif; font-size:0.8rem; font-weight:700;
                            color:var(--surface); background:var(--brand); text-decoration:none;
                            padding:7px 14px; border-radius:8px;" do %>
                Revisar →
              <% end %>

              <%= button_to admin_draft_path(activity),
                    method: :delete,
                    form: { style: "display:inline;", data: { turbo_confirm: "Descartar '#{activity.title}'? Esta ação não pode ser desfeita." } },
                    style: "font-family:'Plus Jakarta Sans',sans-serif; font-size:0.8rem; font-weight:600;
                            color:var(--error); background:var(--error-tint); border:1.5px solid var(--error-border);
                            padding:7px 14px; border-radius:8px; cursor:pointer;" do %>
                Descartar
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

</div>
